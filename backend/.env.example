# Copy to .env and fill in. Never commit .env.

# --- Gnani AI (key from app.gnani.ai/voice; API reference at docs.gnani.ai) ---
GNANI_API_KEY=
# Defaults follow docs.gnani.ai; change only if Gnani tells you to.
GNANI_BASE_URL=https://api.vachana.ai
# Speech-to-text model: empty = Prisma v2.5 (Gnani's default), or prisma-v3.0
GNANI_STT_MODEL=
# Text-to-speech: timbre-v3.0 (voice Lakshmi, recommended) or timbre-v2.5 (Lavanya for Telugu, Nalini for Hindi, Kaveri for English)
GNANI_TTS_MODEL=timbre-v3.0
# Optional: one voice name for every language (must exist in the chosen model's catalog)
GNANI_TTS_VOICE=
# Evon is not on Gnani's API platform. Only if you host Evon yourself (OpenAI-compatible):
GNANI_LLM_URL=
GNANI_LLM_KEY=
GNANI_LLM_MODEL=evon-v3.3
# 1 = skip Gnani calls (typed text only, template answers, no audio) for local development
GNANI_MOCK=0

# --- Safety ---
# 1 during a farmer pilot: entries not yet verified against PJTSAU/ICAR and the CIB&RC label
# go to the agriculture officer instead of showing a dose.
BLOCK_UNVERIFIED=0

# --- Server ---
PORT=5000
# Sites allowed to call the API from a browser (comma-separated). Not needed when serve.py serves the built app itself.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Questions per minute per device (0 = off). Protects your Gnani credits.
RATE_LIMIT_PER_MIN=20
# 1 when running behind a proxy or host (Render, Railway, Docker) so each farmer's own address is rate-limited.
TRUST_PROXY=0
# Where pilot data is written. On a host, point this at a persistent disk.
PILOT_LOG_PATH=pilot_log.jsonl
# The built React app that serve.py also serves (npm run build in frontend/).
FRONTEND_DIST=../frontend/dist
